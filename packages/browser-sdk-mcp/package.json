{
  "name": "@soulsniper-v2/browser-sdk-mcp",
  "version": "0.1.1",
  "description": "MCP server for Browser SDK provider-neutral browser tools.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "browser-sdk-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@soulsniper-v2/browser-sdk": "0.1.1",
    "playwright-core": "^1.58.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoulSniper-V2/browser-sdk.git",
    "directory": "packages/browser-sdk-mcp"
  },
  "homepage": "https://github.com/SoulSniper-V2/browser-sdk#readme",
  "keywords": [
    "browser-automation",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "browserbase",
    "cloudflare"
  ]
}
